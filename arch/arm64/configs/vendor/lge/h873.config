# LG Platform
CONFIG_MACH_MSM8996_LUCYE_GLOBAL_CA=y

# DirtySanta-style modem fixups for engineering bootloaders
CONFIG_DIRTYSANTA_FIXUP_G6=y
CONFIG_DIRTYSANTA_FIXUP_G6_DEVICENAME="LG-H873"
# Preserve the H873 firmware's stock NT code. It is carrier/region specific.
CONFIG_DIRTYSANTA_FIXUP_G6_NTCODE=""
CONFIG_DIRTYSANTA_FIXUP_G6_SIMCOUNT=1

# Remove incorrect modem parameters from the G600L engineering bootloader cmdline
CONFIG_CMDLINE_SEARCHREPLACE=y
CONFIG_CMDLINE_SAR_ENABLE0=y
CONFIG_CMDLINE_SAR_SEARCH0=" model.name=LGM-G600L "
CONFIG_CMDLINE_SAR_REPLACE0=" "
CONFIG_CMDLINE_SAR_ENABLE1=y
CONFIG_CMDLINE_SAR_SEARCH1=" androidboot.serialno=LGMG600L"
CONFIG_CMDLINE_SAR_REPLACE1=" androidboot.serialno=LGH873"

# Broadcom Wi-Fi (H873 stock firmware uses BCM4359)
CONFIG_BCMDHD=y
CONFIG_BCMDHD_EXT=y
CONFIG_BCMDHD_PCIE=y
CONFIG_BCM4359=y
CONFIG_BCMDHD_COB=y
CONFIG_BCMDHD_USE_SCHED_SCAN=y
CONFIG_BCMDHD_HOSTAPD_BGN_MODE=y
CONFIG_BCMDHD_FOLLOW_AP_DTIM_PERIOD=y
CONFIG_WIFI_CONTROL_FUNC=y

# H873 Global-CA board support (FM remains disabled)
CONFIG_SND_USE_QUAT_MI2S=y
CONFIG_SND_USE_SKU_INFO=y
